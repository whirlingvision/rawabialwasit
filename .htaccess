# Apache .htaccess file for Rawabi Alwasit Website
# This file sets Content Security Policy headers to fix form submission and resource loading issues

# Set default directory index file - ONLY index.html (no index.php)
DirectoryIndex index.html index.htm

# Explicit rewrite rule for root domain (fallback if DirectoryIndex doesn't work)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ /index.html [L]
</IfModule>

# Custom 404 error page
ErrorDocument 404 /404.html

# Enable mod_headers if available
<IfModule mod_headers.c>
    # Set Content Security Policy
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://maps.googleapis.com https://maps.gstatic.com; connect-src 'self' https://formsubmit.co; form-action 'self' https://formsubmit.co;"
</IfModule>

# Alternative: If mod_headers is not available, the CSP meta tag in HTML will be used as fallback
